{
  "name": "stacker-40",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "analyze:bundle": "npm run build && node scripts/analyze-bundle.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "party:dev": "wrangler dev",
    "party:deploy": "wrangler deploy",
    "party:check": "tsc -p party/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/graphics": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@pixi/text": "^7.4.3",
    "jose": "^6.2.3",
    "nostr-bal-browser-sdk": "github:soyezequiel/herramientas-nostr",
    "nostr-game-protocol": "github:soyezequiel/Nostr-Game-Protocol",
    "nostr-tools": "^2.23.12",
    "partyserver": "^0.5.8",
    "partysocket": "^1.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "vite": "~7.3.6",
    "vitest": "^4.0.15",
    "wrangler": "~4.107.1"
  }
}
